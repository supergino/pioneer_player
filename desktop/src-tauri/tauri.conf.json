{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pioneer Controller",
  "version": "2.0.0",
  "identifier": "com.andrea.pioneer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": ["resources/**/*"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
